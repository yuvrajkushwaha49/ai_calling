DATABASE_URL="mysql://crm_user:crm_password@localhost:3306/realestate_crm"
JWT_SECRET="your_jwt_secret_min_32_chars"
JWT_EXPIRES_IN="7d"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Voice stack — ElevenLabs only (TTS + STT/Scribe). Sarvam unused.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=

# Exotel (live phone calls)
# Local: cloudflared tunnel → set PUBLIC_BASE_URL to the https URL
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_APP_ID=
EXOTEL_REGION=
EXOTEL_GREETING_MODE=
PUBLIC_BASE_URL=

# Conversation LLM — Gemini (primary)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_EMBED_MODEL=text-embedding-004

# Optional OpenAI fallback (unused while LLM_PROVIDER=gemini)
OPENAI_API_KEY=

# Google Calendar — auto-book meetings from AI calls
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Twilio (live phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
